      "who": "host",
      "text": "I'm a floating head made of light. I am the ghost.",
      "shot": "host",
      "smug": true
    },
    {
      "who": "guest",
      "text": "Fair. What about a costume for me?",
      "shot": "guest"
    },
    {
      "who": "host",
      "text": "You're in a kilt next to a pumpkin. You've already won.",
      "shot": "wide"
    },
    {
      "who": "guest",
      "text": "Is all this AI stuff not a bit scary, though?",
      "shot": "guest"
    },
    {
